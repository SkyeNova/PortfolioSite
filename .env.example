# GitHub activity (/activity/ and the homepage card). Copy to .env; .env is git-ignored.
# Restart the server after editing: .env is read once at startup.

# Classic personal access token. Create one at https://github.com/settings/tokens/new
# with scopes: read:user (private contribution counts), repo (private repo names,
# commit history and languages stay server-side and are redacted), read:org (orgs).
# Fine-grained tokens can't span organisations, so use a classic one.
# Without a token the site falls back to the public contributions graph and public
# repos, then to data/github_fixture.json (shown as sample data).
GITHUB_TOKEN=

# Whose activity to show. The token owner should be this user.
GITHUB_LOGIN=SkyeNova

# IANA zone for "today", streaks and the punch card.
SITE_TZ=Europe/London

# Public repos to treat as private anyway (owner/name, comma separated).
GITHUB_HIDE_REPOS=

# First year on the heatmap.
GITHUB_FIRST_YEAR=2023

# Set to 1 to render the committed sample data regardless of cache/token (dev only).
GITHUB_FORCE_FIXTURE=

# ---------- News (/news/ and the homepage strip) ----------
# Pulled from playsolaris.net/blog, callisto.host/api/news and astrofoxstudios.com/blog,
# cached in cache/news_*.json. Offline it serves data/news_fixture.json
# (rebuild with: .venv/bin/python -m studionews.build_fixture).
NEWS_TTL_MINUTES=30
# Set to 1 to skip the network and always serve the fixture (dev only).
NEWS_FORCE_FIXTURE=

# ---------- Blog (/blog/) ----------
# Set to 1 to render posts marked `draft: true` (with a Draft label). Leave empty in production.
BLOG_SHOW_DRAFTS=

# Comments on posts, through giscus (GitHub Discussions). Leave empty to hide comments.
# Get all four from https://giscus.app after installing the giscus app on the repo.
GISCUS_REPO=
GISCUS_REPO_ID=
GISCUS_CATEGORY=Announcements
GISCUS_CATEGORY_ID=

# ---------- Tests / fixture (keep real values out of the public repo) ----------
# Comma-separated names the site must never show (checked by tests).
UNANNOUNCED_NAMES=
# Posts to leave out of the news fixture: source/slug, comma separated.
FIXTURE_SKIP=
